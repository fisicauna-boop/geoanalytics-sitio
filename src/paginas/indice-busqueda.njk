---
permalink: /indice-busqueda.json
eleventyExcludeFromCollections: true
---
[
{%- for a in collections.articulos %}
  {%- set img = a.data.imagen or "" %}
  {
    "titulo": {{ a.data.title | json | safe }},
    "url": {{ a.url | json | safe }},
    "resumen": {{ a.data.description | json | safe }},
    "categoria": {{ (categorias | buscarPor("slug", a.data.categoria)).nombre | json | safe }},
    "categoria_slug": {{ a.data.categoria | json | safe }},
    "etiquetas": {{ a.data.etiquetas | json | safe }},
    "fecha": {{ a.date | fecha | json | safe }},
    "fecha_iso": {{ a.date | fechaCorta | json | safe }},
    "imagen": {{ img | json | safe }},
    "texto": {{ a.content | textoPlano(5000) | json | safe }}
  }{% if not loop.last %},{% endif %}
{%- endfor %}
]
