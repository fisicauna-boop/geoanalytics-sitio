{#- Íconos de línea para los servicios. Uso: icono("gondola") -#}
{% macro icono(nombre, clase="") %}
<svg class="icono {{ clase }}" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
{%- if nombre == "datos" -%}
<path d="M8 40h32"/><rect x="11" y="24" width="6" height="16" rx="1"/><rect x="21" y="16" width="6" height="24" rx="1"/><rect x="31" y="9" width="6" height="31" rx="1"/><path d="M10 18l9-6 8 4 11-9" class="icono__acento"/>
{%- elif nombre == "gondola" -%}
<rect x="8" y="6" width="32" height="36" rx="2"/><path d="M8 18h32M8 30h32"/><rect x="12" y="10" width="5" height="8" class="icono__acento"/><rect x="19" y="10" width="5" height="8" class="icono__acento"/><rect x="26" y="22" width="5" height="8"/><rect x="12" y="22" width="5" height="8"/><rect x="19" y="34" width="5" height="8"/><path d="M30 37h6" stroke-dasharray="2 3"/>
{%- elif nombre == "ruta" -%}
<circle cx="10" cy="38" r="4"/><circle cx="38" cy="10" r="4"/><circle cx="34" cy="34" r="3"/><circle cx="14" cy="12" r="3"/><path d="M14 38h12a6 6 0 0 0 6-6v-2M10 34V18a4 4 0 0 1 4-4M17 12h10a7 7 0 0 1 7 7v7" class="icono__acento"/>
{%- elif nombre == "encuesta" -%}
<rect x="9" y="6" width="30" height="36" rx="3"/><path d="M15 15h4M15 24h4M15 33h4"/><path d="M24 15h9M24 24h9M24 33h6"/><path d="M14 23l2 2 4-4" class="icono__acento"/>
{%- elif nombre == "mapa" -%}
<path d="M6 12l11-4 14 4 11-4v28l-11 4-14-4-11 4z"/><path d="M17 8v28M31 12v28"/><path d="M24 30s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z" class="icono__acento"/><circle cx="24" cy="19" r="2.5" class="icono__acento"/>
{%- elif nombre == "campo" -%}
<rect x="12" y="4" width="24" height="40" rx="4"/><path d="M21 39h6"/><path d="M24 26s6-5 6-9a6 6 0 0 0-12 0c0 4 6 9 6 9z" class="icono__acento"/><circle cx="24" cy="17" r="2" class="icono__acento"/>
{%- endif -%}
</svg>
{% endmacro %}
