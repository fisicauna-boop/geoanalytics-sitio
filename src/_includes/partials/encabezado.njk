{% from "partials/macros.njk" import simbolo %}
{%- set purl = page.url if page.url else "/sin-url/" -%}
<header class="encabezado">
  <div class="encabezado__fila contenedor">
    <a class="marca" href="/" aria-label="{{ site.nombre }} — inicio">
      <svg class="marca__isotipo" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
        <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <path d="M5 19c4-3 7-2 10 0s7 3 12-1" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <path d="M7 12c3-2 6-2 9 0s6 2 9 0" fill="none" stroke="currentColor" stroke-width="1.6" opacity=".55"/>
        <circle cx="20" cy="15" r="2.6" class="marca__punto"/>
      </svg>
      <span class="marca__texto">Geo<b>analytics</b></span>
    </a>
    <p class="encabezado__lema">{{ site.lema }}</p>

    <div class="encabezado__acciones">
      <a class="icono-btn" href="/buscar/" aria-label="Buscar publicaciones" data-abrir-busqueda>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </a>
      <a class="boton boton--cabecera" href="/contacto/">Solicitar consulta</a>
      <button class="icono-btn menu-btn" type="button" aria-controls="nav-principal" aria-expanded="false" aria-label="Abrir menú">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <nav class="nav" id="nav-principal" aria-label="Principal">
    <ul class="contenedor">
      {% for item in navegacion %}
      {%- set activo = (purl == item.url) or (item.url != "/" and purl.startsWith(item.url)) or (item.url == "/articulos/" and purl.startsWith("/etiquetas/")) -%}
      {%- set c = categorias | buscarPor("slug", item.url | replace("/", "")) -%}
      <li><a href="{{ item.url }}"{% if c %} class="cat--{{ c.slug }}"{% endif %}{% if activo %} aria-current="page"{% endif %}>{% if c %}{{ simbolo(c.simbolo) }}{% endif %}{{ item.texto }}</a></li>
      {% endfor %}
      <li class="nav__contacto"><a href="/contacto/"{% if page.url == "/contacto/" %} aria-current="page"{% endif %}>Contacto</a></li>
    </ul>
  </nav>

  <div class="busqueda-rapida" hidden>
    <form class="contenedor busqueda-rapida__form" action="/buscar/" role="search">
      <label class="visualmente-oculto" for="q-rapida">Buscar publicaciones</label>
      <input id="q-rapida" name="q" type="search" placeholder="Buscar artículos, temas o etiquetas" autocomplete="off">
      <button class="boton" type="submit">Buscar</button>
    </form>
  </div>
</header>
