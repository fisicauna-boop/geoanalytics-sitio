<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "partials/seo.njk" %}
<meta name="theme-color" content="#0B2D4A">
<link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="{{ site.nombre }} — publicaciones" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/assets/css/estilos.css">
{% block head %}{% endblock %}
</head>
<body class="{{ clase_body }}" data-base="{{ '/' | url }}">
<a class="saltar" href="#contenido">Saltar al contenido</a>
{% include "partials/encabezado.njk" %}
<main id="contenido">
{% block contenido %}{{ content | safe }}{% endblock %}
</main>
{% include "partials/pie.njk" %}
<script src="/assets/js/main.js" defer></script>
{% block scripts %}{% endblock %}
{% if site.analitica.goatcounter %}
<script data-goatcounter="https://{{ site.analitica.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{% endif %}
</body>
</html>
