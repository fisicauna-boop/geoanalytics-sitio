---
layout: layouts/base.njk
clase_body: pagina-inicio
---
{% from "partials/macros.njk" import tarjeta %}
{% from "partials/iconos.njk" import icono as dibujarIcono %}

{# 1. Portada #}
<section class="portada">
  <div class="contenedor portada__grilla">
    <div class="portada__texto">
      <p class="portada__antetitulo">Estadística · Inteligencia comercial · Analítica geoespacial</p>
      <h1 class="portada__titulo">La ventaja no está en tener datos. <span>Está en saber qué hacer con ellos.</span></h1>
      <p class="portada__bajada">Integramos estadística, investigación de mercados, trade marketing, ruteo y geomarketing para convertir información dispersa en decisiones que se pueden ejecutar y medir.</p>
      <div class="portada__acciones">
        <a class="boton boton--claro" href="/demostraciones/">Explorar las demostraciones</a>
        <a class="boton boton--contorno" href="#contacto">Solicitar propuesta</a>
      </div>
    </div>
    <figure class="portada__escena">
      <div class="hero3d" data-hero3d>
        <img class="hero3d__fijo" src="/media/portadas/ciudad-3d.webp" alt="Ilustración 3D de una ciudad comercial con tiendas, una ruta de visitas iluminada y paneles de análisis flotando sobre las manzanas." width="1258" height="900" fetchpriority="high">
      </div>
      <figcaption>Concepto visual. Los indicadores y gráficos de muestra no representan resultados reales de clientes.</figcaption>
    </figure>
  </div>
  <div class="contenedor">
    <ul class="areas" aria-label="Áreas de trabajo">
      <li><strong>Data Analytics</strong><span>Datos, indicadores e insights</span></li>
      <li><strong>Trade Intelligence</strong><span>Ejecución y desempeño comercial</span></li>
      <li><strong>Field Operations</strong><span>Rutas, visitas y productividad</span></li>
      <li><strong>Market Research</strong><span>Encuestas y comportamiento</span></li>
    </ul>
  </div>
</section>
<script type="module" src="/assets/js/hero3d.js"></script>

{# 2. Servicios #}
<section class="seccion" aria-labelledby="serv-t">
  <div class="contenedor">
    <div class="seccion__cabecera">
      <h2 id="serv-t" class="seccion__titulo">Una mirada integral, respuestas accionables</h2>
      <a class="seccion__mas" href="/servicios/">Ver todos los servicios</a>
    </div>
    <ul class="servicios-inicio">
      {% for s in collections.servicios %}
      <li>
        <a href="{{ s.url }}">
          <span class="servicios-inicio__icono">{{ dibujarIcono(s.data.icono) }}</span>
          <span class="servicios-inicio__nombre">{{ s.data.title }}</span>
          <span class="servicios-inicio__desc">{{ s.data.description }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{# 3. Vitrina de demostraciones #}
<section class="seccion seccion--oscura" aria-labelledby="demo-t">
  <div class="contenedor">
    <div class="seccion__cabecera">
      <h2 id="demo-t" class="seccion__titulo">Menos promesas, más demostración</h2>
      <a class="seccion__mas" href="/demostraciones/">Ver las demostraciones</a>
    </div>
    <div class="vitrina" data-vitrina>
      <div class="vitrina__pestanas" role="tablist" aria-label="Demostraciones">
        {% for d in demos %}
        <button class="vitrina__pestana" role="tab" id="tab-{{ d.id }}" aria-controls="panel-{{ d.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}">
          <span class="vitrina__pestana-titulo">{{ d.pestana }}</span>
          <span class="vitrina__pestana-sub">{{ d.pestana_sub }}</span>
        </button>
        {% endfor %}
        <p class="vitrina__nota">Datos simulados que se generan en su navegador. No representan resultados de clientes.</p>
      </div>
      {% for d in demos %}
      <div class="vitrina__panel" role="tabpanel" id="panel-{{ d.id }}" aria-labelledby="tab-{{ d.id }}"{% if not loop.first %} hidden{% endif %}>
        <a class="vitrina__imagen" href="{{ d.url }}" tabindex="-1" aria-hidden="true"><img src="{{ d.imagen }}" alt="" width="1200" height="675" loading="lazy"></a>
        <div class="vitrina__texto">
          <p class="vitrina__sub">{{ d.subtitulo }}</p>
          <h3 class="vitrina__titulo">{{ d.titulo }}</h3>
          <p>{{ d.texto }}</p>
          <p class="vitrina__calcula-t">Qué calcula</p>
          <ul class="vitrina__calcula">{% for c in d.calcula %}<li>{{ c }}</li>{% endfor %}</ul>
          <a class="boton" href="{{ d.url }}">Abrir la demostración</a>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# 4. Industrias y metodología #}
<section class="seccion" aria-labelledby="ind-t">
  <div class="contenedor dos-columnas">
    <div>
      <h2 id="ind-t" class="seccion__titulo">Soluciones que hablan el idioma de su negocio</h2>
      <ul class="industrias-lista">
        {% for i in industrias %}
        <li><a href="/industrias/#{{ i.id }}"><span class="industrias-lista__nombre">{{ i.nombre }}</span><span class="industrias-lista__pregunta">{{ i.preguntas[0] }}</span></a></li>
        {% endfor %}
      </ul>
    </div>
    <div>
      <h2 class="seccion__titulo">Del problema a una decisión defendible</h2>
      <ol class="metodo metodo--vertical">
        {% for m in metodologia %}
        <li class="metodo__paso">
          <span class="metodo__num" aria-hidden="true">{{ loop.index }}</span>
          <h3 class="metodo__titulo">{{ m.paso }}</h3>
          <p>{{ m.texto }}</p>
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>

{# 5. Artículos y contacto #}
{%- set arts = collections.articulos | limitar(3) -%}
{% if arts.length %}
<section class="seccion seccion--suave" aria-labelledby="art-t">
  <div class="contenedor">
    <div class="seccion__cabecera">
      <h2 id="art-t" class="seccion__titulo">Ideas que abren mejores preguntas</h2>
      <a class="seccion__mas" href="/articulos/">Ver todas las publicaciones</a>
    </div>
    <div class="grilla grilla--tres">
      {% for a in arts %}{{ tarjeta(a, categorias, "normal", 3) }}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="seccion contacto-inicio" id="contacto" aria-labelledby="con-t">
  <div class="contenedor contacto">
    <div>
      <h2 id="con-t" class="seccion__titulo contacto-inicio__titulo">¿Qué decisión necesita resolver?</h2>
      <p class="seccion__bajada">Cuéntenos el desafío. Le respondemos con el enfoque analítico, los datos necesarios, el alcance, los plazos y los costos. También puede <a href="/simulador/">simular el costo de un estudio</a>.</p>
      <ul class="puntos-contacto">
        <li><strong>Enfoque a medida</strong><span>Una propuesta alineada al problema real de su empresa.</span></li>
        <li><strong>Rigor metodológico</strong><span>Supuestos, fuentes, muestras y márgenes de error explícitos.</span></li>
        <li><strong>Orientación a la acción</strong><span>Resultados pensados para decidir y ejecutar.</span></li>
      </ul>
    </div>
    <div class="contacto-inicio__form">
      {% include "partials/formulario-contacto.njk" %}
    </div>
  </div>
</section>
<script src="/assets/js/contacto.js" defer></script>
<script src="/assets/js/vitrina.js" defer></script>
