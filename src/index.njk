---
layout: layouts/base.njk
clase_body: pagina-inicio
---
{% from "partials/macros.njk" import tarjeta %}
{% from "partials/iconos.njk" import icono as dibujarIcono %}
{%- set todos = collections.articulos -%}
{%- set dest = todos | destacados -%}
{%- set principal = dest[0] if dest.length else todos[0] -%}
{%- set recientes = todos | excepto(principal.url if principal else "") | limitar(3) -%}

<section class="portada">
  <div class="contenedor portada__grilla">
    <div class="portada__texto">
      <p class="portada__antetitulo">Estadística · Inteligencia comercial · Analítica geoespacial</p>
      <h1 class="portada__titulo">Convertimos datos en decisiones que generan resultados</h1>
      <p class="portada__bajada">Investigación de mercados, trade marketing, analítica estadística, ruteo y geomarketing en una sola propuesta para empresas en Paraguay.</p>
      <div class="portada__acciones">
        <a class="boton boton--claro" href="/servicios/">Nuestros servicios</a>
        <a class="boton boton--contorno" href="/contacto/">Solicitar propuesta</a>
      </div>
    </div>
    <figure class="portada__escena">
      <div class="hero3d" data-hero3d>
        <img class="hero3d__fijo" src="/media/portadas/ciudad-3d.webp" alt="Ilustración 3D de una ciudad comercial con tiendas, una ruta de visitas iluminada y paneles de análisis flotando sobre las manzanas." width="1258" height="900" fetchpriority="high">
      </div>
      <figcaption>Concepto visual. Los indicadores y gráficos de muestra no representan resultados reales de clientes.</figcaption>
    </figure>
  </div>
  <div class="contenedor">
    <ul class="areas" aria-label="Áreas de trabajo">
      <li><strong>Data Analytics</strong><span>Datos, indicadores e insights</span></li>
      <li><strong>Trade Intelligence</strong><span>Ejecución y desempeño comercial</span></li>
      <li><strong>Field Operations</strong><span>Rutas, visitas y productividad</span></li>
      <li><strong>Market Research</strong><span>Encuestas y comportamiento</span></li>
    </ul>
  </div>
</section>
<script type="module" src="/assets/js/hero3d.js"></script>

<section class="seccion" aria-labelledby="serv-t">
  <div class="contenedor">
    <div class="seccion__cabecera">
      <h2 id="serv-t" class="seccion__titulo">Servicios</h2>
      <a class="seccion__mas" href="/servicios/">Ver todos los servicios</a>
    </div>
    <p class="seccion__bajada">Seis frentes de trabajo que se combinan según la decisión que su empresa necesita tomar.</p>
    <ul class="servicios-inicio">
      {% for s in collections.servicios %}
      <li>
        <a href="{{ s.url }}">
          <span class="servicios-inicio__icono">{{ dibujarIcono(s.data.icono) }}</span>
          <span class="servicios-inicio__nombre">{{ s.data.title }}</span>
          <span class="servicios-inicio__desc">{{ s.data.description }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="seccion seccion--oscura" aria-labelledby="demo-t">
  <div class="contenedor">
    <div class="seccion__cabecera">
      <h2 id="demo-t" class="seccion__titulo">Demostraciones interactivas</h2>
      <a class="seccion__mas" href="/demostraciones/">Ver las demostraciones</a>
    </div>
    <p class="seccion__bajada">Pruebe cómo trabajamos con datos simulados: nada de lo que se muestra corresponde a clientes reales.</p>
    <div class="demos-grilla">
      {% for d in demos %}
      <a class="demo-tarjeta" href="{{ d.url }}">
        <img src="{{ d.imagen }}" alt="" width="1200" height="675" loading="lazy">
        <span class="demo-tarjeta__sub">{{ d.subtitulo }}</span>
        <span class="demo-tarjeta__titulo">{{ d.titulo }}</span>
        <span class="demo-tarjeta__texto">{{ d.texto }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="seccion" aria-labelledby="ind-t">
  <div class="contenedor">
    <div class="seccion__cabecera">
      <h2 id="ind-t" class="seccion__titulo">Soluciones por industria</h2>
      <a class="seccion__mas" href="/industrias/">Ver por industria</a>
    </div>
    <ul class="industrias-inicio">
      {% for i in industrias %}
      <li><a href="/industrias/#{{ i.id }}"><span class="industrias-inicio__nombre">{{ i.nombre }}</span><span class="industrias-inicio__pregunta">{{ i.preguntas[0] }}</span></a></li>
      {% endfor %}
    </ul>
  </div>
</section>

{% include "partials/metodologia.njk" %}

{% if principal %}
<section class="seccion" aria-labelledby="ult-t">
  <div class="contenedor">
    <div class="seccion__cabecera">
      <h2 id="ult-t" class="seccion__titulo">Artículos y análisis</h2>
      <a class="seccion__mas" href="/articulos/">Ver todas las publicaciones</a>
    </div>
    <div class="destacado">
      {{ tarjeta(principal, categorias, "grande", 3) }}
      {% if recientes.length %}
      <div class="destacado__lista">
        {% for a in recientes %}{{ tarjeta(a, categorias, "lista", 3) }}{% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{% set cta_titulo = "¿Qué decisión necesita tomar su empresa?" %}
{% set cta_texto = "Cuéntenos qué quiere medir, investigar u ordenar. Le respondemos con una propuesta de alcance, datos necesarios, plazos y costos." %}
{% set cta_boton = "Solicitar propuesta" %}
{% include "partials/cta.njk" %}
